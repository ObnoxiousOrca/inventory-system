# Copy this file to `.env` for local development. NEVER commit the real .env file.
# In AWS (ECS/Fargate) these values are injected by the Terraform task definition,
# and AWS credentials come from the ECS *task role* - do not set AWS keys there.

NODE_ENV=development
PORT=3000

# Region of your AWS resources.
# REPLACE with the region you deploy to (e.g. ap-south-1 for Mumbai).
AWS_REGION=ap-south-1

# DynamoDB table name. Must match the table created by Terraform / scripts/createTable.js.
DYNAMODB_TABLE=inventory-products

# LOCAL DEVELOPMENT ONLY: point to DynamoDB Local (docker-compose starts it).
# Leave this EMPTY/commented when running against real AWS.
DYNAMODB_ENDPOINT=http://localhost:8000
# DynamoDB Local accepts any dummy credentials. Remove these two lines for real AWS.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# SNS topic ARN for low-stock alerts.
# REPLACE with the `sns_topic_arn` Terraform output
# (format: arn:aws:sns:<region>:<account-id>:<topic-name>).
# Leave EMPTY to disable alerts locally (they are only logged).
SNS_TOPIC_ARN=

# Allowed browser origin(s) for CORS, comma separated.
# REPLACE with your CloudFront / S3 website URL in production.
CORS_ORIGINS=http://localhost:5173

# Log level: fatal | error | warn | info | debug
LOG_LEVEL=info
